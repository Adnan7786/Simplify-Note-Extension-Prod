{
  "name": "Simplify Note",
  "description": "Create notes on the go",
  "version": "1.3",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*.pdf"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "/images/logo.png",
      "32": "/images/logo.png",
      "48": "/images/logo.png",
      "128": "/images/logo.png"
    },
    "default_title": "Click here to start creating notes"
  },
  "oauth2": {
    "client_id": "156135009791-p28gu01qf2n5gj4p9ntnhmfi22f4v67j.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents",
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "/images/logo.png",
    "32": "/images/logo.png",
    "48": "/images/logo.png",
    "128": "/images/logo.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "/images/*",
        "/src/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}